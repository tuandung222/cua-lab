# copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for the policy (see README for current ids)
CUA_MODEL=claude-sonnet-5-5

# Optional: pin the computer tool version. Default is the GA toolset.
# CUA_TOOL=computer_toolset_20260801
# Legacy fallback (needs a beta header on old accounts):
# CUA_TOOL=computer_20250124
# CUA_ANTHROPIC_BETA=computer-use-2025-01-24

# Optional: route through an Anthropic-compatible gateway (no /v1 suffix).
# Expect typed computer tools to be rewritten; see README before choosing a tool.
# ANTHROPIC_BASE_URL=https://gateway.example.com
